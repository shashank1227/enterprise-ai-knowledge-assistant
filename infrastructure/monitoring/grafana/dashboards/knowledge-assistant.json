{
  "title": "Knowledge Assistant",
  "uid": "ka-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["knowledge-assistant"],
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"enterprise-knowledge-assistant\"}[1m])) by (uri, method, status)",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP P95 Latency (s)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"enterprise-knowledge-assistant\"}[1m])) by (le, uri))",
          "legendFormat": "p95 {{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "JVM Heap Used (MB)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"enterprise-knowledge-assistant\", area=\"heap\"} / 1024 / 1024",
          "legendFormat": "Heap Used MB"
        }
      ]
    },
    {
      "id": 4,
      "title": "DB Connection Pool",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"enterprise-knowledge-assistant\"}",
          "legendFormat": "Active"
        },
        {
          "expr": "hikaricp_connections_pending{application=\"enterprise-knowledge-assistant\"}",
          "legendFormat": "Pending"
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP Error Rate (%)",
      "type": "stat",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_requests_seconds_count{application=\"enterprise-knowledge-assistant\", status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"enterprise-knowledge-assistant\"}[5m]))",
          "legendFormat": "5xx Error %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 1, "color": "yellow" },
              { "value": 5, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Cache Hit Ratio",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(cache_gets_total{application=\"enterprise-knowledge-assistant\", result=\"hit\"}[1m]) / rate(cache_gets_total{application=\"enterprise-knowledge-assistant\"}[1m])",
          "legendFormat": "{{name}} hit ratio"
        }
      ]
    },
    {
      "id": 7,
      "title": "Active Threads",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{application=\"enterprise-knowledge-assistant\"}",
          "legendFormat": "Live Threads"
        },
        {
          "expr": "jvm_threads_daemon_threads{application=\"enterprise-knowledge-assistant\"}",
          "legendFormat": "Daemon Threads"
        }
      ]
    }
  ]
}
